{
  "name": "electron-nest-react",
  "version": "1.0.0",
  "description": "Full-stack Electron Desktop Application powered by NestJS Backend and React + Vite Frontend",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "dist:win": "npm run build:engine && npm run build && electron-builder --win nsis portable --x64",
    "test:prod-smoke": "npm run build:main && node scripts/production-smoke.cjs",
    "dev:main": "tsc -w -p tsconfig.json",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "dev:electron": "electron .",
    "dev": "concurrently --kill-others \"npm run dev:main\" \"npm run dev:renderer\" \"electron .\"",
    "test:e2e": "electron scripts/e2e-like-comment.cjs",
    "test:e2e:real-tiktok": "electron scripts/e2e-real-tiktok.cjs",
    "start": "electron .",
    "test:feature-ui": "node scripts/test-feature-ui.cjs",
    "test:workflows": "npm run build:main && tsc scripts/workflow-checks.ts --target ES2022 --module commonjs --skipLibCheck --outDir tmp/workflow-tests && node tmp/workflow-tests/workflow-checks.js",
    "test:packaged": "tsc scripts/packaged-workflow-checks.ts --target ES2022 --module commonjs --skipLibCheck --outDir tmp/packaged-tests && electron tmp/packaged-tests/packaged-workflow-checks.js",
    "predev": "npm run build:engine && npm run build:main",
    "prestart": "npm run build:engine && npm run build:main",
    "predev:electron": "npm run build:engine && npm run build:main",
    "test:parity": "node scripts/parity-regression-checks.cjs",
    "build:engine": "node scripts/build-native-engine.cjs",
    "test:native": "npm run build:main && node scripts/native-engine-checks.cjs",
    "test:native:packaged": "node scripts/native-engine-checks.cjs --packaged",
    "test:native:browser": "dotnet run --project scripts/native-browser-checks/NativeBrowserChecks.csproj"
  },
  "build": {
    "appId": "com.seedingtiktok.desktop",
    "productName": "Seeding TikTok",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "native-engine/publish",
        "to": "native-engine",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.6",
    "playwright-core": "1.48.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
